{
  "name": "harem-empire-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/runtime-assets.mjs prune-build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "assets:fetch": "node scripts/runtime-assets.mjs fetch",
    "assets:verify": "node scripts/runtime-assets.mjs verify",
    "pretest": "node scripts/runtime-assets.mjs verify"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@xstate/react": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "three": "^0.186.1",
    "xstate": "^5.21.0"
  }
}
