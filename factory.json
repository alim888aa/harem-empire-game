  },
  "execution": {
    "location": "cloud",
    "mode": "parent-manual",
    "enabled": true,
    "automatic": false,
    "owner": "parent-assistant",
    "reason": "Parent dispatches native Sol workers by hand; stock T3 CLI is unsupported"
  },
  "budgetPolicy": {
    "timezone": "Asia/Ulaanbaatar",
    "accounting": "flat-job-estimates",
    "refactorDate": "2026-10-10",
    "refactorDayLimitUsd": 100,
    "maintenanceDailyLimitUsd": 30,
    "maintenanceWhenNeeded": true,
    "priorityBypass": false,
    "atEstimatedLimit": "stop-new-work-running-work-finishes",
    "ledger": "docs/factory/estimated-usage.json"
  },
  "verification": {
    "command": "npm run factory:check",
    "browserProofRequired": true,
    "fixture": "base",
    "ready": false
  },
  "budgetUsd": 30,
  "metrics": {
    "enabled": false,
