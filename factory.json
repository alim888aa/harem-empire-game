  "smallChangeMaxFiles": 10,
  "protected": [
    "feature:saves",
    "feature:campaign"
  ],
  "paths": {
    "schema": [
      "src/persistence/**"
    ],
    "ui": [
      "src/components/**",
      "src/ui/**",
      "src/palace/**/*.tsx"
    ]
  },
  "maxParallel": 1,
  "upkeep": {
    "keepDays": 14
  },
  "upstream": {
    "repository": "alim888aa/agent-org",
    "commit": "974e9d78a29466de9edf1144a3a27aedea491eb8"
  },
  "execution": {
    "location": "cloud",
    "enabled": false,
    "owner": "parent-assistant",
    "reason": "No supported cost-bounded cloud launcher and exact-head browser fixture yet"
  },
  "budgetPolicy": {
    "refactor": {
      "limitUsd": 100,
      "period": "total"
    },
    "ongoing": {
      "limitUsd": 30,
      "period": "day",
      "timezone": "UTC"
    },
    "activePhase": "refactor",
    "priorityBypass": false,
    "onUnknownUsage": "hold-all",
    "accounting": "unavailable"
  },
  "verification": {
    "command": "npm run factory:check",
    "browserProofRequired": true,
    "fixture": "base",
    "ready": false
  }
}
